# Local Development Settings for Thassi
# Your discovered Home Assistant instance on the local network:
HA_URL=http://192.168.188.92:8123

# Create a Long-Lived Access Token in Home Assistant:
# Profile -> Security -> Long-Lived Access Tokens -> Create Token
HA_TOKEN=

# Optional: URL of the running Thassi Host Add-on for <1s hot deployments via `npm run deploy <app>`
THASSI_HOST_URL=http://192.168.188.92:8099
THASSI_DEPLOY_SECRET=

# Local persistent data folder when running `npm run dev`
THASSI_DATA_DIR=./data
PORT=8099
