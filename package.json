{
  "name": "thassi",
  "version": "1.0.0",
  "private": true,
  "description": "Full-stack TypeScript workflow & Micro-PaaS for installing custom webapps and personal data tools as Home Assistant Add-ons",
  "type": "module",
  "scripts": {
    "thassi": "tsx packages/cli/src/index.ts",
    "dev": "tsx packages/cli/src/index.ts dev",
    "build": "tsx packages/cli/src/index.ts build",
    "create": "tsx packages/cli/src/index.ts create",
    "deploy": "tsx packages/cli/src/index.ts deploy",
    "export": "tsx packages/cli/src/index.ts export",
    "list": "tsx packages/cli/src/index.ts list",
    "typecheck": "tsc --noEmit",
    "test:python": "python -m unittest discover -s python_modules -p \"test_*.py\" -v",
    "test:workflow": "tsx apps/project-workflow/backend/verify-phase5.ts"
  },
  "dependencies": {
    "@tensorflow-models/coco-ssd": "^2.2.3",
    "@tensorflow/tfjs": "^4.22.0",
    "jpeg-js": "^0.4.4",
    "pngjs": "^7.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.4",
    "esbuild": "^0.24.2",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vite": "^6.0.5"
  }
}
