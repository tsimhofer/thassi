{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "jsx": "react-jsx",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "baseUrl": ".",
    "paths": {
      "@thassi/sdk": ["./packages/sdk/src/index.ts"],
      "@thassi/sdk/client": ["./packages/sdk/src/client.ts"]
    }
  },
  "include": [
    "packages/**/*",
    "apps/**/*",
    "thassi_host/**/*"
  ],
  "exclude": [
    "node_modules",
    "**/dist/**"
  ]
}
